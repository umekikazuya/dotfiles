[user]
	useConfigOnly = true
	name = Kazuya Umeki
	email = 108924738+umekikazuya@users.noreply.github.com

[include]
	path = ~/.config/git/.gitconfig.local

[core]
	editor = nvim
	quotepath = false
	hooksPath = ~/.config/git/hooks
	excludesfile = ~/.config/git/.gitignore_global
	pager = delta

[push]
	default = simple
	autoSetupRemote = true

[ghq]
	root = ~/src

[filter "lfs"]

	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[alias]
	st = status -u -s
	logo = log --oneline
	logn = log --name-status --oneline
	lg = log --graph --all --date-order --pretty=format:'%C(yellow)%h%C(reset) - %C(bold red)%d%C(reset) %s %C(green)(%ad)%C(reset) %C(bold blue)<%an>%C(reset)' --date=format-local:'%Y/%m/%d %H:%M'
	fp = fetch --prune --all
	sw = switch
	bd = branch -D
	ci = commit -v
	ame = commit --amend
	di = diff
	di-s = diff --staged
	aa = add .
	res = restore
	ress = restore --staged

[init]
	defaultBranch = develop

[commit]
	gpgsign = true
	template = ~/.config/git/.commit_template

[tag]
	gpgSign = true

[gpg]
	program = gpg


[interactive]
    diffFilter = delta --color-only

[delta]
  navigate = true  # use n and N to move between diff sections
  light = true      # or `light = true`, or omit for auto-detection
  line-numbers = true
	hyperlinks = true
	side-by-side = true
  whitespace-error-style = 22 reverse
	true-color = always

[merge]
    conflictStyle = zdiff3

# --- color ---

[color]

	ui = auto

[color "branch"]

	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]

	meta = yellow bold
	frag = magenta bold # line info
	old = red # deletions
	new = green # additions

[color "status"]

	added = yellow
	changed = green
	untracked = cyan